# Django Configuration
SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=*

# Google Gemini AI Integration
GEMINI_API_KEY=your-gemini-api-key-here

# Database Configuration (MySQL for production, or leave empty/set USE_SQLITE=True for SQLite)
USE_SQLITE=False
DB_NAME=datamind_db
DB_USER=root
DB_PASSWORD=your-mysql-password
DB_HOST=127.0.0.1
DB_PORT=3306

# Encryption
DB_CREDENTIAL_ENCRYPTION_KEY=your-encryption-key-here
